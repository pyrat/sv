{
  "name": "dawinchi",
  "version": "1.0.0",
  "description": "Dawinci is the codename for the new (smarter)Smart Winch",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "tsoa": "tsoa spec-and-routes",
    "start": "node dist/app.esm.js",
    "dev": "sudo nodemon -L app.mjs --ignore 'config/*' ",
    "test": "jest --verbose",
    "test-queue": "jest --verbose test/queue",
    "compile": "tsoa spec-and-routes && tsc",
    "watch": "tsc -w",
    "docker:build": "docker build --platform linux/arm/v7 -t rubenlarsen/dawinchi:latest ../",
    "docker:dev": "docker run -v %cd%/../:/app -v /app/dawinchi-api/node_modules -d -p 3500:3500 --name daWinchi rubenlarsen/dawinchi:latest",
    "docker:devrpi": "docker run -v $(pwd)/../:/app -v /app/dawinchi-api/node_modules -d -p 3500:3500 --name daWinchi rubenlarsen/dawinchi:latest",
    "docker:push": "npm run docker:build && docker push rubenlarsen/dawinchi:latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImencoAS/dawinchi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ImencoAS/dawinchi/issues"
  },
  "homepage": "https://github.com/ImencoAS/dawinchi#readme",
  "devDependencies": {
    "@jest/globals": "^29.6.0",
    "@jest/transform": "^29.6.0",
    "@types/better-queue": "^3.8.3",
    "@types/better-sqlite3": "^7.6.4",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/i2c-bus": "^5.1.0",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.2",
    "@types/node-cron": "^3.0.8",
    "@types/rpio": "^2.4.3",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "^9.0.2",
    "concurrently": "^8.2.0",
    "jest": "^29.6.0",
    "jest-ts-webcompat-resolver": "^1.0.0",
    "nodemon": "^2.0.20",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsoa": "^5.1.1",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@types/conf": "^3.0.0",
    "@types/sqlite3": "^3.1.8",
    "ads1115": "^1.2.0",
    "better-queue": "^3.8.12",
    "better-queue-sqlite": "^1.0.7",
    "better-sqlite3": "^8.4.0",
    "body-parser": "^1.20.0",
    "conf": "^10.2.0",
    "cors": "^2.8.5",
    "cron-validator": "^1.3.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.1",
    "i2c-bus": "^5.2.2",
    "jfile": "^1.1.12",
    "jsonwebtoken": "^8.5.1",
    "node-cron": "^3.0.2",
    "node-pid-controller": "^1.0.1",
    "rpio": "^2.4.2",
    "sqlite3": "^5.1.6",
    "swagger-ui-express": "4.5",
    "uuid": "^9.0.0",
    "winston": "^3.8.2"
  }
}
